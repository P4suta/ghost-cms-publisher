{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>P4suta/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["cargo install --locked --version (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+) cargo-sort"],
      "datasourceTemplate": "crate",
      "depNameTemplate": "cargo-sort"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^crates/ghost-cms-xtask/src/main\\.rs$/"],
      "matchStrings": [
        "const IMAGE: &str =\\s*\"(?<depName>ghost):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+-alpine)@(?<currentDigest>sha256:[a-f0-9]{64})\";"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
